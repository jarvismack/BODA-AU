DEBUG=0
SECRET_KEY=replace-with-a-64-plus-character-random-secret-key-generated-for-production
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,your-subdomain.ngrok-free.app
CSRF_TRUSTED_ORIGINS=https://your-subdomain.ngrok-free.app
ADMIN_ALLOWED_IPS=127.0.0.1

# Database (Production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bodaboda
DB_USER=bodaboda_user
DB_PASSWORD=replace-with-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# HTTPS / proxy settings for ngrok
USE_X_FORWARDED_HOST=1
TRUST_X_FORWARDED_FOR=0
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0

# Set to 1 only for temporary ngrok testing without nginx static/media proxy.
SERVE_MEDIA_INSECURE=1
SERVE_STATIC_INSECURE=1

# Upload limits
MAX_PROFILE_IMAGE_BYTES=2097152
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_MEMORY_SIZE=8388608

# Android update metadata
APP_VERSION_CODE=1
APP_VERSION_NAME=1.0
APP_APK_URL=https://your-domain.example/bodaau-release.apk
BACKUP_DIR=/var/backups/bodaau
PUSH_PROVIDER=native
PUSH_POLL_INTERVAL_SECONDS=60
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# App rate limits
RATE_LIMIT_BURST_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_5_MIN=15
RATE_LIMIT_REGISTER_PER_HOUR=30
SCHEDULED_MATCH_LEAD_MINUTES=15
SCHEDULED_MATCH_RETRY_MINUTES=5
SCHEDULED_MIN_LEAD_MINUTES=10

# Logging
LOG_LEVEL=INFO
MONITORING_ENABLED=1
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# SMS provider
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (OTP + password reset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@bodaboda.app
