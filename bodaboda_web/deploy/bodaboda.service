[Unit]
Description=Bodaboda Django App
After=network.target

[Service]
User=jarviscoder
Group=www-data
WorkingDirectory=/home/jarviscoder/Documents/BodaBoda App/bodaboda_web
Environment="DJANGO_SETTINGS_MODULE=bodaboda_web.settings.prod"
Environment="PATH=/home/jarviscoder/Documents/BodaBoda App/bodaboda_web/.venv/bin"
ExecStart=/home/jarviscoder/Documents/BodaBoda App/bodaboda_web/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8001 \
    --timeout 60 \
    bodaboda_web.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
